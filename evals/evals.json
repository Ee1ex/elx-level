{
  "version": "2.2",
  "language": "zh-CN",
  "cases": [
    {
      "id": "level1-downloadable-tool",
      "prompt": "我有一个离线工具，会重新打包上传新版本供用户下载，但没有账号、云端业务数据或在线服务责任，请判断 LEVEL。",
      "expected_output": {
        "trigger": true,
        "level": 1,
        "requires_level_confirmation": true
      },
      "files": [
        "SKILL.md",
        "references/level-selection.md",
        "LEVEL.md"
      ]
    },
    {
      "id": "level1-static-online-page",
      "prompt": "帮我做一个部署到线上但没有用户系统的静态展示页，先判断 LEVEL。",
      "expected_output": {
        "trigger": true,
        "level": 1,
        "requires_level_confirmation": true
      },
      "files": [
        "SKILL.md",
        "references/level-selection.md",
        "LEVEL.md"
      ]
    },
    {
