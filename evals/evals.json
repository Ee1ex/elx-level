        "schemas/workflow-state.schema.json"
      ]
    },
    {
      "id": "migration-explicit-level2",
      "prompt": "旧 LEVEL 3 项目想按新的自有线上产品 LEVEL 2 继续，请要求我留下重新确认记录，不要自动映射。",
